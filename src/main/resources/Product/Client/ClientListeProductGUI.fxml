<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefWidth="1100" prefHeight="800"
        stylesheets="/Styles/StyleProduct.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.Controlleurs.ProductControlleur.Client.ClientListeProductControlleur">

    <VBox
            spacing="0"
            AnchorPane.topAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.bottomAnchor="0.0">

        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-container">
            <padding>
                <Insets top="20.0" left="30.0" right="30.0" bottom="20.0"/>
            </padding>

            <Button text="⬅ Retour" onAction="#goBackToMenu" styleClass="btn-back">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Button>

            <Label text="📦" styleClass="page-icon"/>

            <VBox spacing="2.0">
                <Label text="Mes Abonnements" styleClass="page-title">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Label>
                <Label text="Gérez vos produits et abonnements actifs" styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="6.0" styleClass="stat-pill">
                <Label text="Total :" styleClass="stat-pill-label"/>
                <Label fx:id="totalProductsLabel" text="0 abonnement" styleClass="stat-pill-value">
                    <font><Font name="System Bold" size="12.0"/></font>
                </Label>
            </HBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-container">
            <padding>
                <Insets top="14.0" left="30.0" right="30.0" bottom="14.0"/>
            </padding>

            <Label text="🔍" style="-fx-font-size: 14px;"/>

            <TextField
                    fx:id="searchField"
                    promptText="Rechercher par catégorie, type, statut, description..."
                    prefWidth="380.0"
                    styleClass="search-input"/>

            <Button text="Rechercher" onAction="#handleSearch" styleClass="btn-search"/>

            <Button text="↺ Réinitialiser" onAction="#handleReset" styleClass="btn-reset"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Filtrez par catégorie, statut ou type d'abonnement" styleClass="search-hint"/>
        </HBox>

        <VBox VBox.vgrow="ALWAYS" styleClass="list-container">
            <padding>
                <Insets top="16.0" left="20.0" right="20.0" bottom="16.0"/>
            </padding>

            <ListView
                    fx:id="SubProductsListeView"
                    VBox.vgrow="ALWAYS"
                    styleClass="product-listview"/>
        </VBox>

    </VBox>

</AnchorPane>
