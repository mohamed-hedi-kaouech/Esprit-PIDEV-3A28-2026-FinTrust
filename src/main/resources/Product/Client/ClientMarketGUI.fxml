<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="1100" prefHeight="800" stylesheets="/Styles/StyleProduct.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controlleurs.ProductControlleur.Client.ClientMarketControlleur">

    <VBox spacing="20.0" AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
        <padding>
            <Insets top="30.0" left="30.0" right="30.0" bottom="30.0" />
        </padding>

        <Button text="⬅ Retour" onAction="#goBackToMenu" styleClass="btn-back">
            <font>
                <Font name="System Bold" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header-container">
            <Label text="📦" styleClass="page-icon" />
            <Label styleClass="page-title" text="Liste des Produits">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <VBox spacing="15.0" styleClass="list-container" VBox.vgrow="ALWAYS">
            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="search-container">
                <TextField fx:id="searchField" promptText="🔍 Rechercher un produit..." prefWidth="300.0" styleClass="search-input" />
                <Button text="Rechercher" styleClass="btn-search" onAction="#handleSearch" />
                <Button text="Réinitialiser" styleClass="btn-reset" onAction="#handleReset" />
            </HBox>

            <ListView fx:id="productListView" styleClass="product-listview" VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="10.0" styleClass="pagination-info">
                <Label fx:id="totalProductsLabel" text="Total: 0 produits" styleClass="info-label">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
            </HBox>
        </VBox>
    </VBox>

</AnchorPane>
